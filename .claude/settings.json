{
  "permissions": {
    "allow": [
      "Bash(node -e ' *)",
      "Bash(node_modules/.bin/ng build *)",
      "Bash(new_app/node_modules/.bin/ng build *)",
      "Bash(git *)",
      "Bash(node scripts/enrich_wikipedia.js *)",
      "Bash(bd *)",
      "Bash(git -C c:/github/topcastles *)",
      "Bash(ADMIN_TOKEN=test-secret node server/index.js)",
      "Bash(curl -s http://localhost:3000/api/admin/health)",
      "Bash(curl -s -H \"Authorization: Bearer test-secret\" http://localhost:3000/api/admin/health)",
      "Bash(curl -s -H \"Authorization: Bearer wrong\" http://localhost:3000/api/admin/health)",
      "Bash(python3 -c \"import sys,json; d=json.load\\(sys.stdin\\); print\\(json.dumps\\({'status':d.get\\('status'\\)}\\)\\)\")",
      "Bash(ADMIN_TOKEN=test-secret node tests/server-smoke.test.js http://localhost:3000)",
      "Bash(python3 -c \"import sys,json; d=json.load\\(sys.stdin\\); print\\(f'{len\\(d\\)} records, fields: {list\\(d[0].keys\\(\\)\\)[:10]}'\\)\")",
      "Read(//data/castle-images/small/**)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f graphify-out/graph.json ] && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: Knowledge graph exists at graphify-out/graph.json. Use `graphify query graphify-out/graph.json <name>` to look up symbols instead of searching raw files.\"}}' || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ]
  }
}
